# Warisan Aleen AI Agent - Copy to .env and fill in real values.

# Ollama local LLM
OLLAMA_BASE_URL=http://localhost:11434
# For Bahasa Malaysia + English copy, llama3.2:1b works on low-RAM machines.
# Pull larger models with: `ollama pull qwen2.5:7b` or `llama3.1:8b`
OLLAMA_MODEL=llama3.2:1b

# Meta asset IDs (already filled for Warisan Aleen)
FB_PAGE_ID=1369264899593189
IG_ACCOUNT_ID=17841425967343775
INSTAGRAM_USERNAME=warisanaleen
BUSINESS_ID=1070676568896535

# Access token: 60-day Page access token from /oauth/access_token exchange.
# Leave empty until Meta Business Verification is approved + Advanced Access granted.
ACCESS_TOKEN=

# Publishing safety switch
# DRY_RUN=true means generate content but never publish to Meta (safe mode).
DRY_RUN=true
# When DRY_RUN=false, post this many times per day (1-2)
POSTS_PER_DAY=2

# Storage
DB_PATH=warisan.db

# Server
PORT=8000
HOST=0.0.0.0