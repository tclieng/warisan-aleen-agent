{
  "name": "Warisan Aleen - Daily Post",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hours": [9, 17] }
          ]
        }
      },
      "id": "cron1",
      "name": "Daily Cron (09:00 & 17:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"topic\": \"\", \"platform\": \"both\" }",
        "options": {}
      },
      "id": "gen1",
      "name": "Generate Post (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/posts/{{ $json.id }}/publish",
        "options": {}
      },
      "id": "pub1",
      "name": "Publish Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [760, 300]
    }
  ],
  "connections": {
    "cron1": { "main": [ [ { "node": "gen1", "type": "main", "index": 0 } ] ] },
    "gen1": { "main": [ [ { "node": "pub1", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "versionId": "warisan-v1"
}
